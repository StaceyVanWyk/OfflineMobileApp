
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OfflineMobileApp.Views.ProductPage"
    Title="Product Catalogue"
    BackgroundColor="#F8F3EB">

    <Grid RowDefinitions="Auto,*"
          Padding="16,20">

        <!-- Catalogue heading -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="8"
                             Margin="0,0,0,18">

            <Label Text="Shop Products"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#342C25" />

            <Label Text="Browse our available products"
                   FontSize="14"
                   TextColor="#958779" />

        </VerticalStackLayout>

        <!-- Scrollable product catalogue -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Products}"
                        SelectionMode="Single"
                         SelectionChanged="OnProductSelected"
                        VerticalScrollBarVisibility="Always">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="12"
                                 VerticalItemSpacing="16"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White"
                            Stroke="#EFE5D9"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="8">

                        <VerticalStackLayout Spacing="7">

                            <Image Source="{Binding ImageName}"
                                   HeightRequest="135"
                                   Aspect="AspectFill"/>

                            <Label Text="{Binding ProductName}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#342C25"
                                   LineBreakMode="WordWrap"/>

                            <Label Text="{Binding Description}"
                                   FontSize="11"
                                   TextColor="#958779"
                                   MaxLines="2"/>

                            <Label Text="{Binding Price, StringFormat='R {0:F2}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#F58220"/>

                            <Label Text="{Binding StockQuantity, StringFormat='Stock: {0}'}"
                                   FontSize="11"
                                   TextColor="#958779"/>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>
