
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OfflineMobileApp.Views.ProductPage"
    Title="Product Catalogue">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label
            Text="Shop Products"
            FontSize="28"
            FontAttributes="Bold"
            TextColor="Black" />

        <Label
            Text="Browse our available products"
            FontSize="14"
            TextColor="Gray" />

        <CollectionView ItemsSource="{Binding Products}">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Padding="15"
                        Margin="0,5"
                        Stroke="#DDDDDD"
                        StrokeThickness="1">

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="{Binding ProductName}"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Description}"
                                FontSize="14"
                                TextColor="Gray" />

                            <Label
                                Text="{Binding Price, StringFormat='R {0:F2}'}"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="Green" />

                            <Label
                                Text="{Binding StockQuantity, StringFormat='Stock available: {0}'}"
                                FontSize="12"
                                TextColor="Gray" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>
