
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OfflineMobileApp.Views.ProductDetailsPage"
    Title="Product Details"
    BackgroundColor="#F8F3EB">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="18">

            <Image Source="{Binding ImageName}"
                   HeightRequest="300"
                   Aspect="AspectFit"/>

            <VerticalStackLayout Spacing="8">

                <Label Text="{Binding ProductName}"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#342C25"/>

                <Label Text="{Binding Description}"
                       FontSize="15"
                       TextColor="#958779"/>

                <Label Text="{Binding Price, StringFormat='R {0:F2}'}"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#F58220"/>

                <Label Text="{Binding StockQuantity, StringFormat='Available stock: {0}'}"
                       FontSize="13"
                       TextColor="#958779"/>

            </VerticalStackLayout>

            <BoxView HeightRequest="1"
                     Color="#E8DED2"/>

            <Label Text="Product Information"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#342C25"/>

            <Label Text="{Binding Description}"
                   FontSize="14"
                   TextColor="#75695D"/>

            <Button Text="Add to Cart"
                    BackgroundColor="#F58220"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="28"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
