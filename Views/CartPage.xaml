

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OfflineMobileApp.Views.CartPage"
    Title="My Cart"
    BackgroundColor="#F8F3EB">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="18">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="5"
                             Margin="0,0,0,20">

            <Label Text="My Shopping Cart"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#342C25"/>

            <Label Text="Review your selected items"
                   FontSize="14"
                   TextColor="#958779"/>

        </VerticalStackLayout>

        <!-- Cart items -->
        <CollectionView Grid.Row="1"
                        x:Name="CartItemsView"
                        VerticalScrollBarVisibility="Always">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border BackgroundColor="White"
                            Stroke="#EFE5D9"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="12"
                            Margin="0,0,0,12">

                        <Grid ColumnDefinitions="95,*"
                              ColumnSpacing="14">

                            <Image Grid.Column="0"
                                   Source="{Binding ImageName}"
                                   HeightRequest="105"
                                   WidthRequest="95"
                                   Aspect="AspectFill"/>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="6">

                                <Label Text="{Binding ProductName}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#342C25"/>

                                <Label Text="{Binding Price, StringFormat='R {0:F2}'}"
                                       FontSize="14"
                                       TextColor="#F58220"/>

                                <HorizontalStackLayout Spacing="12"
                       VerticalOptions="Center">

    <Label Text="Quantity:"
           FontSize="13"
           TextColor="#75695D"
           VerticalOptions="Center"/>

    <Button Text="−"
            Clicked="OnDecreaseQuantityClicked"
            CommandParameter="{Binding .}"
            WidthRequest="32"
            HeightRequest="32"
            CornerRadius="16"
            Padding="0"
            BackgroundColor="#FCE5D1"
            TextColor="#342C25"/>

    <Label Text="{Binding Quantity}"
           FontSize="14"
           FontAttributes="Bold"
           TextColor="#342C25"
           VerticalOptions="Center"/>

    <Button Text="+"
            Clicked="OnIncreaseQuantityClicked"
            CommandParameter="{Binding .}"
            WidthRequest="32"
            HeightRequest="32"
            CornerRadius="16"
            Padding="0"
            BackgroundColor="#F58220"
            TextColor="White"/>

</HorizontalStackLayout>

                                <Label Text="{Binding Subtotal, StringFormat='Subtotal: R {0:F2}'}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#342C25"/>

                            </VerticalStackLayout>

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Cart total and checkout -->
        <VerticalStackLayout Grid.Row="2"
                             Spacing="12"
                             Padding="0,15,0,0">

            <BoxView HeightRequest="1"
                     Color="#E8DED2"/>

            <Grid ColumnDefinitions="*,Auto">

                <Label Text="Total"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#342C25"/>

                <Label x:Name="TotalLabel"
                       Grid.Column="1"
                       Text="R 0.00"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#F58220"/>
                       <Button Text="Remove Item"
        Clicked="OnRemoveItemClicked"
        CommandParameter="{Binding .}"
        BackgroundColor="#FCE5D1"
        TextColor="#B84A35"
        FontSize="12"
        FontAttributes="Bold"
        CornerRadius="15"
        HeightRequest="35"
        HorizontalOptions="Start"
        Padding="12,0"/>

            </Grid>

            <Button Text="Proceed to Checkout"
                    BackgroundColor="#F58220"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="28"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>
